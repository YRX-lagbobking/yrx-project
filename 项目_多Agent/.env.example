# =============================================================================
# 环境变量示例文件（契约第 2 节全量清单）
# -----------------------------------------------------------------------------
# 使用方法：
#   1. 复制为 .env：  copy .env.example .env        （Windows）
#                     cp .env.example .env          （Linux/macOS）
#   2. 把下面留空的敏感项（API Key / Token / 密码）填上真实值；
#   3. .env 已在 .gitignore 中，**不要提交到 Git**（NFR-03 密钥管理）。
#
# 说明：所有值都给了开发态默认值，缺失时 app/core/config.py 会退回默认值，
#       因此没有 .env 项目也能导入并降级运行。
# =============================================================================

# ---------------- 大模型：主模型（云端，流式） ----------------
# 主模型名（DashScope 通义千问系列）
MODEL_LINE_NAME=qwen3-max
# DashScope API Key（敏感，留空待填）
DASHSCOPE_API_KEY=
# OpenAI 兼容接口地址（DashScope compatible-mode）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------------- 大模型：备用模型（降级第 1 级） ----------------
# 备用模型名
MODEL_BACKUP_NAME=deepseek-chat
# 备用模型 API Key（敏感，留空待填）
BACKUP_API_KEY=
# 备用模型接口地址
BACKUP_BASE_URL=https://api.deepseek.com/v1

# ---------------- 大模型：本地模型（降级第 2 级，Ollama） ----------------
# 本地模型名（需先 ollama pull）
MODEL_LOCAL_NAME=qwen2.5:3b
# 本地 Ollama 的 OpenAI 兼容地址
LOCAL_URL=http://localhost:11434/v1

# ---------------- MySQL（业务结构化数据） ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
# 数据库名，需与 sql/init.sql 中 CREATE DATABASE 的名字一致
DB_NAME=health_butler

# ---------------- PostgreSQL（摘要记忆 + LangGraph Checkpointer） ----------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=1234
# 完整连接串（优先使用；留空则用上面的 PG_* 自动拼装）
POSTGRESQL_URL=postgresql://postgres:1234@localhost:5432/postgres?sslmode=disable

# ---------------- Redis（窗口记忆 / 画像 / 会话 / 锁 / Celery broker） ----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis 密码（无密码留空）
REDIS_PASSWORD=
# 完整连接串（Celery broker 与 backend 都用它）
REDIS_URL=redis://localhost:6379/0

# ---------------- Milvus（健康知识向量 + 长期记忆） ----------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 健康知识库集合名
MILVUS_COLLECTION=health_knowledge
# 长期记忆集合名
LONG_MEMORY_COLLECTION=long_memory
# ChromaDB 持久化目录（Milvus 不可用时的降级向量库）
CHROMA_PATH=./app/chroma_db

# ---------------- RAG（切分 / 嵌入 / 重排 / 模式） ----------------
# 向量模型名
EMBEDDING_MODEL=text-embedding-v3
# 精排模型名
RERANK_MODEL=gte-rerank
# 切分块大小（字符）
CHUNK_SIZE=512
# 相邻块重叠字符数
CHUNK_OVERLAP=100
# 检索模式：milvus 向量检索（默认）/ keyword 关键词检索（无向量库的轻量模式）
RAG_MODE=milvus

# ---------------- InfluxDB 3 Core（生命体征时序） ----------------
# InfluxDB 3 服务地址（默认 8181 端口）
INFLUX_URL=http://localhost:8181
# InfluxDB 3 Token（敏感，留空待填）
INFLUX_TOKEN=
# 数据库名，需与建库命令一致：
#   influxdb3 create database --retention-period 30d --token <TOKEN> agent_db
INFLUX_DATABASE=agent_db
# 时序 measurement 名
VITALS_MEASUREMENT=vital_signs
# 运行期写入间隔（分钟）
VITALS_INTERVAL_MINUTES=10
# 启动时回填历史天数（数据连续性策略）
VITALS_BACKFILL_DAYS=7          # 启动补历史天数；0 = 不补（启动更快）

# ---------------- 语音（Vosk 离线识别 + EdgeTTS 合成） ----------------
# Vosk 中文模型目录（须为解压后的模型文件夹绝对路径）
VOSK_PATH=
# EdgeTTS 发音人
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---------------- 邮件（SMTP，用于用药提醒与家属通知） ----------------
EMAIL_HOST=smtp.qq.com
# 收件人（测试用；真实收件人优先取健康档案里的邮箱）
EMAIL_TO=
EMAIL_PORT=465
# 邮箱授权码（敏感，留空待填）
EMAIL_PASSWORD=

# ---------------- MCP 工具服务 ----------------
MCP_SERVER_URL=http://localhost:9000
# MCP 工具调用鉴权 Key（敏感，留空待填；服务端 KeyVerifier 会比对）
MCP_API_KEY=

# ---------------- 安全（JWT + RBAC） ----------------
# JWT 签名密钥（生产必须替换为随机长字符串）
JWT_SECRET_KEY=health-butler-dev-secret
JWT_ALGORITHM=HS256
# Token 有效期（分钟），默认 24 小时
JWT_EXPIRE_MINUTES=1440

# ---------------- 记忆（四层） ----------------
# L1 窗口记忆保留轮数（生产建议 40）
WINDOW_MEMORY_ROUNDS=10
# L1 窗口记忆过期时间（秒），默认 1 天
WINDOW_MEMORY_TIME=86400

# ---------------- 检测与告警 ----------------
# 后台自动检测间隔（分钟），Celery Beat 按此周期触发
DETECT_INTERVAL_MINUTES=5
# 趋势检测窗口天数
TREND_DAYS=7
# 趋势偏离比例阈值（0.3 = 偏离 7 日均值 30% 记为异常趋势）
TREND_DEVIATION=0.3
# 连续同向偏离多少天升级中危
ANOMALY_CONTINUE_DAYS=3
# Checkpointer 类型：postgres 生产 / memory 开发调试
CHECKPOINTER=postgres
# 高危告警是否自动发短信；false 时走"人工确认"流程（need_human_confirm=true）
AUTO_NOTIFY_SMS=true

# ---------------- 规则阈值（第一层检测；改这里不用改代码） ----------------
# 心率上限（次/分）
HR_HIGH=120
# 心率下限（次/分）
HR_LOW=50
# 收缩压上限（mmHg）
BP_SYS_HIGH=180
# 收缩压下限（mmHg）
BP_SYS_LOW=90
# 舒张压上限（mmHg）
BP_DIA_HIGH=110
# 血氧下限（%）
SPO2_LOW=90
# 体温上限（℃）
TEMP_HIGH=37.3
# 体温下限（℃）
TEMP_LOW=36.0
# 空腹血糖上限（mmol/L）
GLUCOSE_HIGH=7.0
# 空腹血糖下限（mmol/L）
GLUCOSE_LOW=3.9
# 睡眠时长下限（小时）
SLEEP_LOW=4

# ---------------- 镜像来源（拉不动时改这里，不用改 compose） ----------------
# 国内网络下若某个镜像加速器返回 403 Forbidden（例如阿里云对 minio/minio），
# 三种处理方式任选其一：
#   1) 运行自动多源试探脚本（推荐）：
#        powershell -ExecutionPolicy Bypass -File scripts\pull_images.ps1
#   2) 在下面直接指定"能拉通"的完整镜像地址（取消注释即可，改完直接 up -d）：
#        MILVUS_IMAGE=registry.cn-hangzhou.aliyuncs.com/<你的命名空间>/milvus:v2.4.13
#        ETCD_IMAGE=bitnami/etcd:3.5
#        MINIO_IMAGE=docker.m.daocloud.io/minio/minio:RELEASE.2023-03-20T20-16-18Z
#        INFLUXDB_IMAGE=influxdb:3-core
#   3) 离线方案：在有网机器上 docker save 出 tar，本机 docker load 导入。
# 提示：也可以用 `docker tag <代理地址拉下来的镜像> <上面的标准名>` 就地改名，
#       这样连这一步配置都不用动。

# ---------------- 混合检索（dense ∪ BM25 → RRF 融合） ----------------
HYBRID_RETRIEVAL=true      # 关掉即回到"单路向量召回"的旧行为
RRF_K=60                   # RRF 常数，业界惯例 60（只用排名，免调参）
BM25_CACHE_TTL=600         # BM25 语料/索引缓存秒数（知识库更新后最多等这么久生效）
BM25_DOCS_DIR=./knowledge_docs   # BM25 语料的目录来源（与 Milvus 向量库同源）
EMBEDDING_DIM=768          # 向量维度兜底（bge-base-zh-v1.5 = 768）
