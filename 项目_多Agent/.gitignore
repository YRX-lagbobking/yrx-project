# =============================================================================
# .gitignore —— 独居老人居家健康管理多智能体系统（项目_多Agent）
# 原则：密钥、备份、缓存、生成物一律不进 Git（公开仓库，务必零密钥）
# =============================================================================

# ---------------- 密钥与本地配置（只放行示例模板） ----------------
.env
.env.*
!.env.example

# ---------------- 我的开发备份（含历史代码，绝不入库） ----------------
*.bak
*.bak2
*.bak3
*.bak4
*.bak4b
*.bak*
*.orig
*.rej

# ---------------- Python 常规 ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ---------------- 虚拟环境 ----------------
.venv/
venv/
env/
ENV/

# ---------------- 测试/类型检查缓存 ----------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---------------- IDE ----------------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------- 运行时数据与生成物 ----------------
app/data/                 # 语音识别模型等大文件（需单独下载）
app/html/tts/             # EdgeTTS 生成的语音
app/html/reports/         # 生成的报告（含老人健康数据，绝不入库）
app/chroma_db/            # ChromaDB 降级向量库
data/
docs/knowledge/*.pdf
docs/knowledge/*.docx

# ---------------- 历史遗留的损坏文件 ----------------
*.broken

# ---------------- Celery 本地调度状态 ----------------
celerybeat-schedule*

# ---------------- 采集/生成的数据 ----------------
*.db
*.sqlite
*.sqlite3
*.log
logs/
*.csv
*.xlsx

# ---------------- 生成的图片（docs/images 手工配图放行） ----------------
*.png
*.jpg
*.jpeg
!docs/images/**

# ---------------- 操作系统 ----------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------- Docker 数据卷 ----------------
docker/volumes/
volumes/
